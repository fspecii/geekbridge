<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberate lint suppressions. Everything else is fixed in code; each entry here says why it stays. -->
<lint>
    <!-- POST_NOTIFICATIONS exists only on API 33+, but both uses are guarded by SDK_INT >= 33 (HomeActivity)
         or only read the permission name for a diagnostics row, which checkSelfPermission handles on old APIs. -->
    <issue id="InlinedApi">
        <ignore path="**/DiagnosticsReport.kt" />
        <ignore path="**/HomeActivity.kt" />
    </issue>
    <!-- Sideloaded app (GitHub releases, not Play): the battery exemption is requested on the user's tap only,
         so phone calls and file transfers survive Doze. Play policy does not apply to this distribution. -->
    <issue id="BatteryLife" severity="ignore" />
    <!-- Dependencies are pinned and verified offline; bumps go through dependabot PRs. -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- x86_64 is packaged by default (packagedAbis); only the release-slimming override drops it. The emulator
         and ChromeOS-on-x86 are supported through that default, so the warning is about a non-default build. -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- Translation is planned (docs/translating.md): user-visible text must live in res/values, never in code or layouts.
         Both are errors so a new hard-coded string fails the build instead of reaching a translator as a surprise. -->
    <issue id="HardcodedText" severity="error" />
    <issue id="SetTextI18n" severity="error" />
    <!-- "%d x" strings that are not plurals yet are real candidates once a language needs a second form; the check stays
         on as a warning and counts are written as <plurals>. -->
    <issue id="PluralsCandidate" severity="warning" />
    <!-- Right-to-left (ar-XB pseudo-locale, and real Arabic / Hebrew later): left/right attributes do not mirror,
         start/end do. The layouts are built in Kotlin with setPaddingRelative / marginStart; these catch the rest. -->
    <issue id="RtlHardcoded" severity="error" />
    <issue id="RtlSymmetry" severity="error" />
    <issue id="RtlEnabled" severity="error" />
    <!-- Translation completeness. A partial translation is fine (Android falls back to English), so a missing one is a
         warning; the default language must be complete, and a stale or malformed translation fails the build. -->
    <issue id="MissingTranslation" severity="warning" />
    <issue id="MissingDefaultResource" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="StringFormatInvalid" severity="error" />
    <issue id="StringFormatMatches" severity="error" />
    <issue id="StringFormatCount" severity="error" />
    <issue id="ImpliedQuantity" severity="error" />
    <!-- DotKit draws a handful of points per frame into two short lists; the allocation is dwarfed by the canvas
         work and the view only redraws on state changes, never in a continuous animation. -->
    <issue id="DrawAllocation">
        <ignore path="**/DotKit.kt" />
    </issue>
    <!-- ShareCoordinator holds only context.applicationContext, which cannot leak an Activity. -->
    <issue id="StaticFieldLeak">
        <ignore path="**/ShareCoordinator.kt" />
    </issue>
    <!-- DotCalendar and TimelineDot are created in code, never inflated from XML, so no AttributeSet constructor. -->
    <issue id="ViewConstructor">
        <ignore path="**/DotCalendar.kt" />
    </issue>
</lint>
