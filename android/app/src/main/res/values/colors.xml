<resources>
    <!-- Design tokens, light theme. Monochrome ink on off-white with ONE red accent (#D71921), used for the
         single live dot, "today", warnings and the unread/primary signal. Dark theme: values-night. -->
    <color name="gb_surface">#F5F5F5</color>
    <color name="gb_card">#FFFFFF</color>
    <color name="gb_stripe">#F0F0F0</color>
    <color name="gb_line">#D6D6D6</color>
    <color name="gb_fill">#E9E9E9</color>
    <color name="gb_text">#0B0B0B</color>
    <color name="gb_muted">#666666</color>
    <color name="gb_accent">#0B0B0B</color>
    <color name="gb_on_accent">#FFFFFF</color>
    <color name="gb_red">#D71921</color>
    <!-- "Ok" is ink, not green: state is always carried by words and by a filled (vs hollow) dot. -->
    <color name="gb_ok">#0B0B0B</color>
    <color name="gb_warn">#C4141C</color>
    <color name="gb_bad">#C4141C</color>
    <!-- Dot-matrix hero/tile: an inverted (dark) tile in light mode so the dots read as lit. -->
    <color name="gb_hero">#0B0B0B</color>
    <color name="gb_on_hero">#FFFFFF</color>
    <color name="gb_hero_dim">#4A4A4A</color>
    <color name="gb_hero_muted">#A8A8A8</color>
    <color name="gb_dot_off">#CFCFCF</color>
</resources>
