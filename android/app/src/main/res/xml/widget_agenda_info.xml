<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: updates are pushed from link / calendar events (see WidgetUpdater). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_agenda_desc"
    android:initialLayout="@layout/widget_agenda"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_agenda"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31"
    android:targetCellHeight="2"
    android:targetCellWidth="4" />
