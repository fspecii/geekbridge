<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Runtime permissions are tied to a visible "Allow" button: contacts, calendar and the coarse call state
      (READ_PHONE_STATE: idle/ringing/in-call only). POST_NOTIFICATIONS is declared (link status, clipboard
      tap request, transfers); SMS and call-number permissions are optional and explained at their declarations
      below. No Bluetooth, storage or location permissions.
      INTERNET is used only by the optional "Computer link" (Rust KDE-protocol transport), which the user
      starts explicitly and which stops when the app leaves the foreground. CHANGE_WIFI_MULTICAST_STATE
      lets that link receive discovery broadcasts while discovery is on; it is a normal, install-time
      permission and is held only while discovery listening is active.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only so "Install update" can hand a SHA-256-verified APK to the system installer; Android still
         asks the user to allow it and to confirm each install. The app never installs silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- A WifiLock (no CPU wake) while a computer is paired and linked, so Wi-Fi power save does not reset the link. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background connection (LinkService): a quiet foreground service of type connectedDevice, only while a
         computer is paired. CHANGE_WIFI_MULTICAST_STATE above is one of the permissions that type requires. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- One of these is a prerequisite for a connectedDevice foreground service on Android 14+. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Setup wizard: "Allow unrestricted battery" (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Only requested when the user switches on "Let the computer edit my calendar" (off by default), so a paired
         computer can add, change and delete one-off events through the Calendar Provider. Google Calendar gets them
         through the phone's own sync; GeekBridge has no Google account, API key or OAuth of its own. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Optional "Messages" sharing (docs/phone-data-link.md), each behind its own switch in the app and off by
         default. Google Play only allows these for the default SMS handler, so they are meant for sideloaded
         / F-Droid builds. GeekBridge is deliberately NOT a default SMS app (no SMS_DELIVER, WAP_PUSH, SENDTO
         or RESPOND_VIA_MESSAGE components): it never writes to the SMS provider and cannot send or read MMS/RCS. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.telephony.messaging" android:required="false" />
    <!-- Optional, each behind its own setup step and off until the user turns call control on:
         ANSWER_PHONE_CALLS lets a paired computer answer, decline or end a call (TelecomManager);
         READ_CALL_LOG is the only way Android hands this app the caller's number (never the log itself). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Optional: CALL_PHONE lets a paired computer you allowed ask this phone to place a call
         (TelecomManager.placeCall) for a plain number, after you confirmed it on the computer. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Optional: progress/result notifications for sharing. Asked once, when the user sends something;
         sharing works without it. No storage permission: received files go through MediaStore. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GeekBridgeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute"
        android:theme="@style/Theme.GeekBridge">

        <!-- The phone app's home screen (launcher). -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup wizard and permission master; opened from Home. -->
        <activity android:name=".SetupActivity" android:exported="false" android:label="@string/setup_label" />

        <!-- Pair by QR code. The computer's QR code carries a geekbridge://pair link: the phone's camera app or Google
             Lens opens it here, so GeekBridge needs no camera permission. The screen asks before it connects. -->
        <activity
            android:name=".QrPairActivity"
            android:label="@string/qr_title"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geekbridge" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Developer details, technical tools and About; opened from Home, not a launcher entry. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/diagnostics_label"
            android:windowSoftInputMode="adjustResize" />

        <!-- Preview of a redacted bug report; opens a GitHub form in the browser only on request. -->
        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:label="@string/report_title" />

        <!-- Keeps the link to paired computers reachable while the app is closed (only when a computer is paired). -->
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Serves the one verified update APK to the package installer. Not exported; access only by URI grant. -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- "Send to computer" in the system Share sheet. -->
        <activity
            android:name=".ShareActivity"
            android:label="@string/share_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.GeekBridge.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver android:name=".ShareActionReceiver" android:exported="false" />

        <!-- Incoming texts for the computer's Messages app; inert unless the user enabled and permitted it. -->
        <receiver
            android:name=".SmsReceivedReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Clipboard sync. The phone never sends its clipboard on its own: the computer asks, and Android
             only lets an app read the clipboard while it has focus, so reads happen in these focused,
             user-started places (tile, notification tap, home button) or on the text-selection menu. -->
        <activity
            android:name=".ClipboardFloatingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- "Send to computer" in the text selection menu (read-only: returns nothing to the caller). -->
        <activity
            android:name=".SendToComputerActivity"
            android:label="@string/process_text_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".ClipboardTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_clipboard"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Serves the one image a computer sent to the clipboard, from the core's private spool. -->
        <provider
            android:name=".ClipImageProvider"
            android:authorities="${applicationId}.clipimg"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Home-screen widgets (RemoteViews, no AndroidX). Not exported: the system delivers widget updates and
             system time broadcasts; every tap is an immutable PendingIntent to one of this app's own components. -->
        <receiver android:name=".ConnectionWidget" android:exported="false" android:label="@string/widget_connection_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_connection_info" />
        </receiver>
        <receiver android:name=".QuickActionsWidget" android:exported="false" android:label="@string/widget_quick_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".AgendaWidget" android:exported="false" android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_info" />
        </receiver>
        <!-- "Send file" from the Quick actions widget: file picker, then the normal share flow. -->
        <activity
            android:name=".WidgetSendFileActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
