<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the update check talk plain http to a local mock release server (see
     UpdateChecker.forBuild and scripts/e2e-android.sh). Release builds keep Android's default of no cleartext. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug only: the scale seeder (ScaleSeedReceiver) writes made-up contacts and events into the emulator's providers. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Debug only: the call_audio_experiment probe (CallAudioProbe) opens an AudioRecord. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application android:networkSecurityConfig="@xml/debug_network_security">
        <!-- Debug only: design gallery for screenshots (see DesignGalleryActivity). -->
        <activity android:name=".DesignGalleryActivity" android:exported="true" android:theme="@style/Theme.GeekBridge" />
        <!-- Debug only: `adb shell am start -n dev.geekbridge.android/.DebugPinWidgetActivity -e w connection|quick|agenda`
             asks the launcher to pin a widget (widget screenshots). Not in release builds. -->
        <activity android:name=".DebugPinWidgetActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug only: seeds made-up contacts and events for scripts/scale-e2e.sh (see ScaleSeedReceiver for the adb command). -->
        <receiver android:name=".ScaleSeedReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Debug only: starts the remote diagnostics with the process (own-log ring, state dump, Diagnostics card).
             See DebugDiagnostics and docs/debug-diagnostics.md. Not in release builds. -->
        <!-- Debug only: flips the opt-in switches from adb for scripts/e2e-debug-diag.sh (see DebugControlReceiver). -->
        <!-- Only the shell (adb holds DUMP) may send it: another app on a debug phone must not flip consents or grants. -->
        <receiver android:name=".DebugControlReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Debug only, EXPERIMENT (docs/design/call-audio-over-wifi.md): Settings > Experimental > Call audio over Wi-Fi. -->
        <activity android:name=".callaudio.CallWifiActivity" android:exported="false" android:theme="@style/Theme.GeekBridge" />
        <!-- scripts/callaudio-enable.sh hands the helper's socket name and token over with this; only the shell (DUMP) may send it. -->
        <receiver android:name=".callaudio.CallWifiReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- The Stop button of the "Call audio is being shared" notification (the app's own PendingIntent only). -->
        <receiver android:name=".callaudio.CallWifiStopReceiver" android:exported="false" />
        <provider
            android:name=".DebugBootProvider"
            android:authorities="${applicationId}.debugboot"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
