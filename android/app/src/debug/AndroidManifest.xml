<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the update check talk plain http to a local mock release server (see
     UpdateChecker.forBuild and scripts/e2e-android.sh). Release builds keep Android's default of no cleartext. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug only: the scale seeder (ScaleSeedReceiver) writes made-up contacts and events into the emulator's providers. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <application android:networkSecurityConfig="@xml/debug_network_security">
        <!-- Debug only: design gallery for screenshots (see DesignGalleryActivity). -->
        <activity android:name=".DesignGalleryActivity" android:exported="true" android:theme="@style/Theme.GeekBridge" />
        <!-- Debug only: `adb shell am start -n dev.geekbridge.android/.DebugPinWidgetActivity -e w connection|quick|agenda`
             asks the launcher to pin a widget (widget screenshots). Not in release builds. -->
        <activity android:name=".DebugPinWidgetActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug only: seeds made-up contacts and events for scripts/scale-e2e.sh (see ScaleSeedReceiver for the adb command). -->
        <receiver android:name=".ScaleSeedReceiver" android:exported="true" />
        <!-- Debug only: starts the remote diagnostics with the process (own-log ring, state dump, Diagnostics card).
             See DebugDiagnostics and docs/debug-diagnostics.md. Not in release builds. -->
        <!-- Debug only: flips the opt-in switches from adb for scripts/e2e-debug-diag.sh (see DebugControlReceiver). -->
        <receiver android:name=".DebugControlReceiver" android:exported="true" />
        <provider
            android:name=".DebugBootProvider"
            android:authorities="${applicationId}.debugboot"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
