<!-- Test-only "other app" for scripts/e2e/share.sh: a content provider that serves generated files (any name, any size,
     optionally throttled or slow to open) and a trampoline activity that starts GeekBridge's ShareActivity the way a
     Gallery, Browser or Files app does (EXTRA_STREAM / ClipData and a temporary read grant). Never shipped. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.geekbridge.e2e.sender">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="GB share sender" android:debuggable="true" android:allowBackup="false">
        <provider
            android:name=".GenProvider"
            android:authorities="dev.geekbridge.e2e.sender"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".SendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
