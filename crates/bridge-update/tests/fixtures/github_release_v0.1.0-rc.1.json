atar_url":"https://avatars.githubusercontent.com/u/4722521?v=4","events_url":"https://api.github.com/users/fspecii/events{/privacy}","followers_url":"https://api.github.com/users/fspecii/followers","following_url":"https://api.github.com/users/fspecii/following{/other_user}","gists_url":"https://api.github.com/users/fspecii/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/fspecii","id":4722521,"login":"fspecii","node_id":"MDQ6VXNlcjQ3MjI1MjE=","organizations_url":"https://api.github.com/users/fspecii/orgs","received_events_url":"https://api.github.com/users/fspecii/received_events","repos_url":"https://api.github.com/users/fspecii/repos","site_admin":false,"starred_url":"https://api.github.com/users/fspecii/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fspecii/subscriptions","type":"User","url":"https://api.github.com/users/fspecii","user_view_type":"public"},"url":"https://api.github.com/repos/fspecii/geekbridge/releases/assets/702787242"},{"browser_download_url":"https://github.com/fspecii/geekbridge/releases/download/v0.1.0-rc.1/SHA256SUMS","content_type":"application/octet-stream","created_at":"2026-11-02T18:43:59Z","digest":"sha256:e327ce42f26f301ca2a72a3a45b5b52096c10e44489914c32fee5d7f6f55163f","download_count":1,"id":702787318,"label":"","name":"SHA256SUMS","node_id":"RA_kwDOVgPwKM4p4672","size":606,"state":"uploaded","updated_at":"2026-11-02T18:43:59Z","uploader":{"avatar_url":"https://avatars.githubusercontent.com/u/4722521?v=4","events_url":"https://api.github.com/users/fspecii/events{/privacy}","followers_url":"https://api.github.com/users/fspecii/followers","following_url":"https://api.github.com/users/fspecii/following{/other_user}","gists_url":"https://api.github.com/users/fspecii/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/fspecii","id":4722521,"login":"fspecii","node_id":"MDQ6VXNlcjQ3MjI1MjE=","organizations_url":"https://api.github.com/users/fspecii/orgs","received_events_url":"https://api.github.com/users/fspecii/received_events","repos_url":"https://api.github.com/users/fspecii/repos","site_admin":false,"starred_url":"https://api.github.com/users/fspecii/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fspecii/subscriptions","type":"User","url":"https://api.github.com/users/fspecii","user_view_type":"public"},"url":"https://api.github.com/repos/fspecii/geekbridge/releases/assets/702787318"}],"assets_url":"https://api.github.com/repos/fspecii/geekbridge/releases/431840513/assets","author":{"avatar_url":"https://avatars.githubusercontent.com/u/4722521?v=4","events_url":"https://api.github.com/users/fspecii/events{/privacy}","followers_url":"https://api.github.com/users/fspecii/followers","following_url":"https://api.github.com/users/fspecii/following{/other_user}","gists_url":"https://api.github.com/users/fspecii/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/fspecii","id":4722521,"login":"fspecii","node_id":"MDQ6VXNlcjQ3MjI1MjE=","organizations_url":"https://api.github.com/users/fspecii/orgs","received_events_url":"https://api.github.com/users/fspecii/received_events","repos_url":"https://api.github.com/users/fspecii/repos","site_admin":false,"starred_url":"https://api.github.com/users/fspecii/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fspecii/subscriptions","type":"User","url":"https://api.github.com/users/fspecii","user_view_type":"public"},"body":"\n\u003e **Release candidate, debug-signed Android APK.** This pre-release is not signed with the release key: you will have to uninstall it before installing a stable release signed with the release key. Pre-releases are not offered by the in-app updaters. Linux and Android builds only; Windows and macOS: build from source.\n\n### Highlights\n- Copy on your phone, paste on your computer (and back), including images, with a hotkey you choose\n- Send files and links between phone and computer over Wi-Fi, straight from the Android Share sheet\n- Answer or decline phone calls from your computer\n- Read and send texts, see your contacts, and keep your Google Calendar in sync with the desktop\n- Pair by scanning a QR code; updates are checked against GitHub and verified before you install\n\n### Added\n- \"What's new\" after an update: a dismissible card at the top of Home on Android and the desktop (once per version, never on a fresh install), `geekbridge-ctl whats-new`, and a link to the full release notes. The text is generated from this file by `scripts/gen-whats-new.sh` and checked for drift by tests.\n- Tray / menu-bar icon in the service (Linux StatusNotifierItem + dbusmenu, Windows notification area; the macOS menu-bar\n  item is type-checked only): dot-matrix icon with connected / disconnected / ringing / update / transfer states, a menu\n  with Open, Paste from phone, Send file, Answer / Decline, Pause sync, Check for updates and Quit. Optional: no tray\n  host means nothing is shown; `geekbridge-ctl tray disable` or `--no-tray` turns it off. Icons in `assets/tray/`\n  (`scripts/gen-tray-icons.sh`), headless check in `scripts/e2e/tray-headless.sh`.\n- Messages: unread badges, search, date separators, SIM choice (phones that list their SIMs), SMS segment counter\n  (GSM/UCS-2), local-only read marks, per-conversation memory cap, MMS \"Attachment\" placeholders, notification Reply\n  action (text hidden unless chosen), plain-language failure reasons and exact SMS-permission steps in the setup wizard.\n\nAndroid APK is DEBUG-signed (prerelease only; not updatable from or to a release build). Signer SHA-256: `4d711ab401391ad4041c7dadd070371eb658d303a08b39de29d1df690a9ca3c3`\n\nAssets: Linux (x86_64 tarball, installer tarball, .deb, Arch package) and Android only. Windows and macOS builds are not part of this release (build from source). Built locally from commit 8237e0243d04; verify downloads against `SHA256SUMS`.\n","created_at":"2026-11-02T18:43:54Z","draft":false,"html_url":"https://github.com/fspecii/geekbridge/releases/tag/v0.1.0-rc.1","id":431840513,"immutable":false,"name":"GeekBridge 0.1.0-rc.1","node_id":"RE_kwDOVgPwKM4ZvV0B","prerelease":true,"published_at":"2026-11-02T18:44:07Z","tag_name":"v0.1.0-rc.1","tarball_url":"https://api.github.com/repos/fspecii/geekbridge/tarball/v0.1.0-rc.1","target_commitish":"main","updated_at":"2026-11-02T18:44:07Z","upload_url":"https://uploads.github.com/repos/fspecii/geekbridge/releases/431840513/assets{?name,label}","url":"https://api.github.com/repos/fspecii/geekbridge/releases/431840513","zipball_url":"https://api.github.com/repos/fspecii/geekbridge/zipball/v0.1.0-rc.1"}
