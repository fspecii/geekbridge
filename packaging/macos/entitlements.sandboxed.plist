<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UNPROVEN alternative: App Sandbox variant (the shape a Mac App Store build would need).
  com.apple.security.device.bluetooth is Apple's sandbox entitlement for Bluetooth devices.
  Whether the sandbox permits Classic Bluetooth HFP (IOBluetoothHandsFreeDevice), a helper spawned
  by a daemon, or reading CoreAudio device lists is not established. Do not ship from this template
  without a hardware test.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
