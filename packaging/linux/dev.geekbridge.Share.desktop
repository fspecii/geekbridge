[Desktop Entry]
Type=Application
Name=GeekBridge Share
Comment=Send files, links and text to your phone and receive from it
Exec=geekbridge-share %F
Icon=dev.geekbridge.Share
Terminal=false
Categories=Network;FileTransfer;
Keywords=share;send;file;transfer;phone;android;geekbridge;
StartupWMClass=dev.geekbridge.Share
