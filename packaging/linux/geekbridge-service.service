[Unit]
Description=GeekBridge background service (phone pairing, clipboard, file share)
Documentation=https://github.com/fspecii/geekbridge
# Ordering only (it does not pull the target in): on a systemd-managed graphical session (uwsm/Omarchy, GNOME, KDE)
# the service starts after the compositor has exported its environment; elsewhere this line changes nothing.
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/geekbridge-service
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# No PrivateTmp: X11 clipboard tools reach the X server through /tmp/.X11-unix, which a private /tmp hides.
# The Wayland socket and the notification bus live in XDG_RUNTIME_DIR, which is shared. On Wayland sessions
# that start this unit before the compositor exports WAYLAND_DISPLAY (uwsm/Omarchy), the service finds the
# socket itself; the autostart launcher also imports the session environment (docs/omarchy.md).

[Install]
WantedBy=default.target
